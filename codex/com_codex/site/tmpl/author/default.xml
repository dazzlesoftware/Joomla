        <option value="card">COM_CODEX_LIST_ITEM_STYLE_CARD</option>
        <option value="learning">COM_CODEX_LIST_ITEM_STYLE_LEARNING</option>
        <option value="simple">COM_CODEX_LIST_ITEM_STYLE_SIMPLE</option>
        <option value="nickel">COM_CODEX_LIST_ITEM_STYLE_NICKEL</option>
      </field>
<field name="author_post_listing_layout" type="list" label="COM_CODEX_POST_LISTING_LAYOUT_LABEL" useglobal="true" validate="options">
        <option value="rows">COM_CODEX_POST_LISTING_LAYOUT_ROWS</option>
        <option value="columns">COM_CODEX_POST_LISTING_LAYOUT_COLUMNS</option>
      </field>
<field name="author_columns_per_row" type="list" label="COM_CODEX_COLUMNS_PER_ROW_LABEL" useglobal="true" validate="options" showon="author_post_listing_layout:columns">
        <option value="2">COM_CODEX_AUTHOR_COLUMNS_PER_ROW_OPTION_2</option>
        <option value="3">COM_CODEX_AUTHOR_COLUMNS_PER_ROW_OPTION_3</option>
        <option value="4">COM_CODEX_AUTHOR_COLUMNS_PER_ROW_OPTION_4</option>
        <option value="5">COM_CODEX_AUTHOR_COLUMNS_PER_ROW_OPTION_5</option>
        <option value="6">COM_CODEX_AUTHOR_COLUMNS_PER_ROW_OPTION_6</option>
      </field>
<field name="author_column_style" type="list" label="COM_CODEX_COLUMN_STYLE_LABEL" useglobal="true" validate="options" showon="author_post_listing_layout:columns">
        <option value="grid">COM_CODEX_COLUMN_STYLE_GRID</option>
        <option value="masonry">COM_CODEX_COLUMN_STYLE_MASONRY</option>
      </field>
<field name="author_items_limit_source" type="list" label="COM_CODEX_AUTHOR_ITEMS_LIMIT_SOURCE_LABEL" validate="options" useglobal="true"><option value="joomla">COM_CODEX_AUTHOR_ITEMS_LIMIT_SOURCE_OPTION_JOOMLA</option><option value="custom">COM_CODEX_AUTHOR_ITEMS_LIMIT_SOURCE_OPTION_CUSTOM</option><option value="5">COM_CODEX_AUTHOR_ITEMS_LIMIT_SOURCE_OPTION_5</option><option value="10">COM_CODEX_AUTHOR_ITEMS_LIMIT_SOURCE_OPTION_10</option><option value="15">COM_CODEX_AUTHOR_ITEMS_LIMIT_SOURCE_OPTION_15</option><option value="20">COM_CODEX_AUTHOR_ITEMS_LIMIT_SOURCE_OPTION_20</option><option value="25">COM_CODEX_AUTHOR_ITEMS_LIMIT_SOURCE_OPTION_25</option><option value="30">COM_CODEX_AUTHOR_ITEMS_LIMIT_SOURCE_OPTION_30</option><option value="50">COM_CODEX_AUTHOR_ITEMS_LIMIT_SOURCE_OPTION_50</option><option value="100">COM_CODEX_AUTHOR_ITEMS_LIMIT_SOURCE_OPTION_100</option></field>
<field name="author_posts_per_page" type="number" label="COM_CODEX_AUTHOR_POSTS_PER_PAGE_LABEL" filter="integer" min="1" showon="author_items_limit_source:custom" useglobal="true" />
<field name="author_listing_exclude_authors" type="postauthors" label="COM_CODEX_AUTHOR_LISTING_EXCLUDE_AUTHORS_LABEL" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Codex\Administrator\Field" description="COM_CODEX_AUTHOR_EXCLUDE_DESC" />
<field name="author_orderby_pri" type="list" label="JGLOBAL_CATEGORY_ORDER_LABEL" useglobal="true" validate="options">
        <option value="none">JGLOBAL_NO_ORDER</option>
        <option value="alpha">JGLOBAL_TITLE_ALPHABETICAL</option>
        <option value="ralpha">JGLOBAL_TITLE_REVERSE_ALPHABETICAL</option>
        <option value="order">JGLOBAL_CATEGORY_MANAGER_ORDER</option>
      </field>
<field name="author_orderby_sec" type="list" label="COM_CODEX_POST_ORDER" useglobal="true" validate="options">
        <option value="front">COM_CODEX_FEATURED_ORDER</option>
        <option value="rdate">JGLOBAL_MOST_RECENT_FIRST</option>
        <option value="date">JGLOBAL_OLDEST_FIRST</option>
        <option value="alpha">JGLOBAL_TITLE_ALPHABETICAL</option>
        <option value="ralpha">JGLOBAL_TITLE_REVERSE_ALPHABETICAL</option>
        <option value="author">JGLOBAL_AUTHOR_ALPHABETICAL</option>
        <option value="rauthor">JGLOBAL_AUTHOR_REVERSE_ALPHABETICAL</option>
        <option value="hits" requires="hits">JGLOBAL_MOST_HITS</option>
        <option value="rhits" requires="hits">JGLOBAL_LEAST_HITS</option>
        <option value="random">JGLOBAL_RANDOM_ORDER</option>
        <option value="order">JGLOBAL_ORDERING</option>
        <option value="rorder">JGLOBAL_REVERSE_ORDERING</option>
        <option value="vote" requires="vote">JGLOBAL_VOTES_DESC</option>
        <option value="rvote" requires="vote">JGLOBAL_VOTES_ASC</option>
        <option value="rank" requires="vote">JGLOBAL_RATINGS_DESC</option>
        <option value="rrank" requires="vote">JGLOBAL_RATINGS_ASC</option>
      </field>
<field name="author_order_date" type="list" label="JGLOBAL_ORDERING_DATE_LABEL" useglobal="true" validate="options">
        <option value="created">JGLOBAL_CREATED</option>
        <option value="modified">JGLOBAL_MODIFIED</option>
        <option value="published">JPUBLISHED</option>
        <option value="unpublished">JUNPUBLISHED</option>
      </field>
<field name="author_show_pagination" type="list" label="JGLOBAL_PAGINATION_LABEL" useglobal="true" class="form-select-color-state" validate="options">
        <option value="0">JHIDE</option>
        <option value="1">JSHOW</option>
        <option value="2">JGLOBAL_AUTO</option>
      </field>
<field name="author_show_pagination_results" type="list" label="JGLOBAL_PAGINATION_RESULTS_LABEL" useglobal="true" class="form-select-color-state" validate="options">
        <option value="0">JHIDE</option>
        <option value="1">JSHOW</option>
      </field>
</fieldset>
<fieldset name="author_slider" label="COM_CODEX_AUTHOR_SLIDER_SETTINGS">
<field name="author_featured_slider_enabled" type="list" label="COM_CODEX_AUTHOR_FEATURED_SLIDER_ENABLED_LABEL" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="author_featured_slider_style" type="list" label="COM_CODEX_AUTHOR_FEATURED_SLIDER_STYLE_LABEL" useglobal="true"><option value="default">COM_CODEX_AUTHOR_FEATURED_SLIDER_STYLE_OPTION_DEFAULT</option><option value="card">COM_CODEX_AUTHOR_FEATURED_SLIDER_STYLE_OPTION_CARD</option><option value="hero">COM_CODEX_AUTHOR_FEATURED_SLIDER_STYLE_OPTION_HERO</option><option value="magazine">COM_CODEX_AUTHOR_FEATURED_SLIDER_STYLE_OPTION_MAGAZINE</option><option value="side-navigation">COM_CODEX_AUTHOR_FEATURED_SLIDER_STYLE_OPTION_SIDE_NAVIGATION</option><option value="slick">COM_CODEX_AUTHOR_FEATURED_SLIDER_STYLE_OPTION_SLICK</option><option value="thumbnail">COM_CODEX_AUTHOR_FEATURED_SLIDER_STYLE_OPTION_THUMBNAIL</option></field>
