<field name="author_featured_slider_count" type="number" label="COM_CODEX_AUTHOR_FEATURED_SLIDER_COUNT_LABEL" min="1" max="50" hint="5" useglobal="true" />
<field name="author_featured_slider_date_source" type="list" label="COM_CODEX_AUTHOR_FEATURED_SLIDER_DATE_SOURCE_LABEL" useglobal="true"><option value="created">COM_CODEX_AUTHOR_FEATURED_SLIDER_DATE_SOURCE_OPTION_CREATED</option><option value="modified">COM_CODEX_AUTHOR_FEATURED_SLIDER_DATE_SOURCE_OPTION_MODIFIED</option><option value="published">COM_CODEX_AUTHOR_FEATURED_SLIDER_DATE_SOURCE_OPTION_PUBLISHED</option></field>
</fieldset>

