<field name="author_featured_slider_image" type="list" label="COM_CODEX_AUTHOR_FEATURED_SLIDER_IMAGE_LABEL" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="author_featured_slider_title" type="list" label="COM_CODEX_AUTHOR_FEATURED_SLIDER_TITLE_LABEL" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
