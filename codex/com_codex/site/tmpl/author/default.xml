      <field name="id" type="postauthors" label="COM_CODEX_AUTHOR_SELECT" required="true" addfieldprefix="Joomla\Component\Codex\Administrator\Field" />
    </fieldset>
  </fields>
  <fields name="params">
<fieldset name="author_posts" label="COM_CODEX_AUTHOR_POSTS_SETTINGS">
<field name="author_list_item_style" type="list" label="COM_CODEX_AUTHOR_ITEM_STYLE" useglobal="true" validate="options">
