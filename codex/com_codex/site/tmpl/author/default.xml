<field name="author_featured_slider_author" type="list" label="COM_CODEX_AUTHOR_FEATURED_SLIDER_AUTHOR_LABEL" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="author_featured_slider_avatar" type="list" label="COM_CODEX_AUTHOR_FEATURED_SLIDER_AVATAR_LABEL" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="author_featured_slider_readmore" type="list" label="COM_CODEX_AUTHOR_FEATURED_SLIDER_READMORE_LABEL" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="author_featured_slider_navigation" type="list" label="COM_CODEX_AUTHOR_FEATURED_SLIDER_NAVIGATION_LABEL" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="author_featured_slider_content" type="list" label="COM_CODEX_AUTHOR_FEATURED_SLIDER_CONTENT_LABEL" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="author_featured_slider_ratings" type="list" label="COM_CODEX_AUTHOR_FEATURED_SLIDER_RATINGS_LABEL" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="author_featured_slider_date" type="list" label="COM_CODEX_AUTHOR_FEATURED_SLIDER_DATE_LABEL" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
