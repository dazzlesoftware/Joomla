<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade"><name>MOD_CODEX_ARCHIVE</name><version>1.0.0</version><description>Family-specific Post Archive module.</description><namespace path="src">Joomla\Module\CodexArchive</namespace><files><folder module="mod_codex_archive">services</folder><folder>src</folder><folder>tmpl</folder></files><languages><language tag="en-GB">language/en-GB/mod_codex_archive.ini</language><language tag="en-GB">language/en-GB/mod_codex_archive.sys.ini</language></languages><config><fields name="params"><fieldset name="basic"><field name="listing_authors" type="postauthors" label="Filter by Authors" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Codex\Administrator\Field" description="Leave empty to inherit the Archive page or component filter." />
<field name="listing_exclude_authors" type="postauthors" label="Exclude Authors" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Codex\Administrator\Field" description="Leave empty to inherit the Archive page or component filter." />
<field name="listing_categories" type="postcategory" label="Filter by Categories" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Codex\Administrator\Field" description="Leave empty to inherit the Archive page or component filter." />
<field name="listing_exclude_categories" type="postcategory" label="Exclude Categories" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Codex\Administrator\Field" description="Leave empty to inherit the Archive page or component filter." />
<field name="listing_tags" type="posttags" label="Filter by Tags" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Codex\Administrator\Field" description="Leave empty to inherit the Archive page or component filter." />
<field name="listing_subcategories" type="list" label="Include Subcategories" class="form-select-color-state" validate="options" default=""><option value="">Inherit</option><option value="0">JNO</option><option value="1">JYES</option></field>
<field name="count" type="number" default="5" min="1" label="Number of items"/></fieldset><fieldset name="advanced"><field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL"/><field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"/><field name="cache" type="list" default="1" label="COM_MODULES_FIELD_CACHING_LABEL"><option value="1">JGLOBAL_USE_GLOBAL</option><option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option></field><field name="cache_time" type="number" default="900" label="COM_MODULES_FIELD_CACHE_TIME_LABEL"/></fieldset></fields></config></extension>