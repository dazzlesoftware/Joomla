<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade"><name>MOD_CODEX_NEWS</name><version>1.0.0</version><description>Family-specific Post News module.</description><namespace path="src">Joomla\Module\CodexNews</namespace><files><folder module="mod_codex_news">services</folder><folder>src</folder><folder>tmpl</folder></files><languages><language tag="en-GB">language/en-GB/mod_codex_news.ini</language><language tag="en-GB">language/en-GB/mod_codex_news.sys.ini</language></languages><config><fields name="params"><fieldset name="automated_truncation" label="Automated Truncation" description="Shorten list content automatically. Manual excerpts and Read More splits take precedence. Featured slider content uses its own settings.">
<field name="truncation_enabled" type="list" label="Enable Automated Truncation" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="truncation_readmore" type="list" label="Display Readmore Button When Necessary" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="truncation_image_position" type="list" label="Position of Images After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_video_position" type="list" label="Position of Videos After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_audio_position" type="list" label="Position of Audio Embed After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_gallery_position" type="list" label="Position of Gallery After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_accordion_position" type="list" label="Position of Accordion After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_alert_position" type="list" label="Position of Alert After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_button_position" type="list" label="Position of Button After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_columns_position" type="list" label="Position of Columns After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_comparison_position" type="list" label="Position of Comparison After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_embed_position" type="list" label="Position of Embed After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_poll_position" type="list" label="Position of Poll After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_quote_position" type="list" label="Position of Quote After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_rule_position" type="list" label="Position of Rule After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_section_position" type="list" label="Position of Section After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_tabs_position" type="list" label="Position of Tabs After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_type" type="list" label="Truncation Type (Joomla Editor)" useglobal="true"><option value="characters">By characters</option><option value="words">By words</option><option value="paragraphs">By paragraph &lt;p&gt;</option><option value="breaks">By break tags &lt;br&gt;</option></field>
<field name="truncation_content_override" type="radio" default="0" label="Maximum Content (Characters or Words)" layout="joomla.form.field.radio"><option value="0">Inherit from default settings</option><option value="1">Use this option</option></field>
<field name="list_excerpt_length" type="number" filter="integer" min="0" label="Maximum Content (Characters or Words)" description="0 displays all content without automatic truncation." hint="400" showon="truncation_content_override:1" />
<field name="truncation_paragraph_override" type="radio" default="0" label="Maximum Paragraph (Paragraph or Break Tags)" layout="joomla.form.field.radio"><option value="0">Inherit from default settings</option><option value="1">Use this option</option></field>
<field name="truncation_paragraphs" type="number" filter="integer" min="0" label="Maximum Paragraph (Paragraph or Break Tags)" description="0 displays all content without automatic truncation." hint="1" showon="truncation_paragraph_override:1" />
</fieldset>
<fieldset name="basic"><field name="catid" type="postcategory" addfieldprefix="Joomla\Component\Codex\Administrator\Field" multiple="true" layout="joomla.form.field.list-fancy-select" label="Categories"/><field name="count" type="number" default="5" min="1" label="Number of items"/><field name="show_date" type="list" class="form-select" label="Show Date" translate_label="false" default=""><option value="">JGLOBAL_USE_GLOBAL</option><option value="0">JHIDE</option><option value="1">JSHOW</option></field><field name="date_type" type="list" class="form-select" label="Date Type" translate_label="false" default=""><option value="">JGLOBAL_USE_GLOBAL</option><option value="created">JGLOBAL_SHOW_CREATE_DATE_LABEL</option><option value="modified">JGLOBAL_SHOW_MODIFY_DATE_LABEL</option><option value="published">JGLOBAL_SHOW_PUBLISH_DATE_LABEL</option></field></fieldset><fieldset name="featured_slider" label="Featured">
<field name="featured_slider_enabled" type="list" label="Display Featured Slider" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="featured_slider_style" type="list" label="Featured Style" useglobal="true"><option value="default">Default</option><option value="card">Card</option><option value="hero">Hero</option><option value="magazine">Magazine</option><option value="side-navigation">Side Navigation</option><option value="slick">Slick</option><option value="thumbnail">Thumbnail</option></field>
<field name="featured_slider_all_pages" type="list" label="Display on All Pages" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="featured_slider_auto" type="list" label="Auto Sliding" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="featured_slider_interval" type="number" label="Auto Sliding Interval (Seconds)" min="1" hint="8" />
<field name="featured_slider_image" type="list" label="Show Post Image" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="featured_slider_title" type="list" label="Show Post Title" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="featured_slider_category" type="list" label="Show Post Category" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="featured_slider_author" type="list" label="Show Post Author" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="featured_slider_avatar" type="list" label="Show Author Avatar" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="featured_slider_readmore" type="list" label="Show Readmore" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="featured_slider_navigation" type="list" label="Show Navigation" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="featured_slider_content" type="list" label="Show Post Content" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="featured_slider_ratings" type="list" label="Show Post Ratings" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="featured_slider_date" type="list" label="Show Post Date" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="featured_slider_content_length" type="number" label="Maximum Content (Characters)" description="0 displays the complete text. Empty inherits the component setting." min="0" hint="250" />
<field name="featured_slider_count" type="number" label="Maximum Featured Posts" min="1" max="50" hint="5" />
<field name="featured_slider_date_source" type="list" label="Post Date Source" useglobal="true"><option value="created">Created Date</option><option value="modified">Modified Date</option><option value="published">Published Date</option></field>
</fieldset>
<fieldset name="advanced"><field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL"/><field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"/><field name="cache" type="list" default="1" label="COM_MODULES_FIELD_CACHING_LABEL"><option value="1">JGLOBAL_USE_GLOBAL</option><option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option></field><field name="cache_time" type="number" default="900" label="COM_MODULES_FIELD_CACHE_TIME_LABEL"/></fieldset></fields></config></extension>