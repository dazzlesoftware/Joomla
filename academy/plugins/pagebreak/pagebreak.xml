<?xml version="1.0" encoding="UTF-8"?>
<extension type="plugin" group="academy" method="upgrade">
  <name>plg_academy_pagebreak</name>
  <author>Joomla! Project</author>
  <creationDate>2005-11</creationDate>
  <copyright>(C) 2005 Open Source Matters, Inc.</copyright>
  <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
  <authorEmail>admin@joomla.org</authorEmail>
  <authorUrl>www.joomla.org</authorUrl>
  <version>3.0.0</version>
  <description>PLG_ACADEMY_PAGEBREAK_XML_DESCRIPTION</description>
  <namespace path="src">Joomla\Plugin\Academy\Pagebreak</namespace>
  <files>
    <folder plugin="pagebreak">services</folder>
    <folder>src</folder>
    <folder>tmpl</folder>
  </files>
  <languages>
    <language tag="en-GB">language/en-GB/plg_academy_pagebreak.ini</language>
    <language tag="en-GB">language/en-GB/plg_academy_pagebreak.sys.ini</language>
  </languages>
  <config>
    <fields name="params">
      <fieldset name="basic">
        <field name="title" type="radio" layout="joomla.form.field.radio.switcher" label="PLG_ACADEMY_PAGEBREAK_SITE_TITLE_LABEL" default="1" filter="integer">
          <option value="0">JHIDE</option>
          <option value="1">JSHOW</option>
        </field>
        <field name="post_index" type="radio" layout="joomla.form.field.radio.switcher" label="PLG_ACADEMY_PAGEBREAK_SITE_POSTINDEX_LABEL" default="1" filter="integer">
          <option value="0">JHIDE</option>
          <option value="1">JSHOW</option>
        </field>
        <field name="post_index_text" type="text" label="PLG_ACADEMY_PAGEBREAK_SITE_POSTINDEXTEXT" showon="post_index:1" />
        <field name="multipage_toc" type="radio" layout="joomla.form.field.radio.switcher" label="PLG_ACADEMY_PAGEBREAK_TOC_LABEL" default="1" filter="integer">
          <option value="0">JHIDE</option>
          <option value="1">JSHOW</option>
        </field>
        <field name="showall" type="radio" layout="joomla.form.field.radio.switcher" label="PLG_ACADEMY_PAGEBREAK_SHOW_ALL_LABEL" default="1" filter="integer">
          <option value="0">JHIDE</option>
          <option value="1">JSHOW</option>
        </field>
        <field name="style" type="list" label="PLG_ACADEMY_PAGEBREAK_STYLE_LABEL" default="pages" validate="options">
          <option value="pages">PLG_ACADEMY_PAGEBREAK_PAGES</option>
          <option value="sliders">PLG_ACADEMY_PAGEBREAK_SLIDERS</option>
          <option value="tabs">PLG_ACADEMY_PAGEBREAK_TABS</option>
        </field>
      </fieldset>
    </fields>
  </config>
</extension>