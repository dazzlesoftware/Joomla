<fields name="params">
<fieldset name="request">
<field name="listing_authors" type="authorfilter" label="Filter by Authors" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Academy\Administrator\Field" description="Leave empty for no restriction. Exclusions take priority over included items." />
<field name="listing_exclude_authors" type="authorfilter" label="Exclude Authors" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Academy\Administrator\Field" description="Leave empty for no restriction. Exclusions take priority over included items." />
<field name="listing_categories" type="postcategory" label="Filter by Categories" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Academy\Administrator\Field" description="Leave empty for no restriction. Exclusions take priority over included items." />
<field name="listing_exclude_categories" type="postcategory" label="Exclude Categories" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Academy\Administrator\Field" description="Leave empty for no restriction. Exclusions take priority over included items." />
<field name="listing_tags" type="posttags" label="Filter by Tags" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Academy\Administrator\Field" description="Leave empty for no restriction. Exclusions take priority over included items." />
<field name="listing_canonical" type="url" label="Custom Canonical Link" filter="url" relative="false" description="Optional absolute HTTP or HTTPS URL for this listing page." />
<field name="listing_subcategories" type="globaldefaultlist" globalcomponent="com_academy" addfieldprefix="Joomla\Component\Academy\Administrator\Field" label="Include Subcategories" useglobal="true" class="form-select-color-state" validate="options"><option value="0">JNO</option><option value="1">JYES</option></field>
</fieldset>
<fieldset name="author_slider" label="Slider">
