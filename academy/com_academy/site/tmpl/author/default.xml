<field name="author_featured_slider_avatar" type="list" label="COM_ACADEMY_AUTHOR_FEATURED_SLIDER_AVATAR_LABEL" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="author_featured_slider_readmore" type="list" label="COM_ACADEMY_AUTHOR_FEATURED_SLIDER_READMORE_LABEL" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
