        <option value="next">COM_ACADEMY_COMPACT_NEXT</option><option value="latest">COM_ACADEMY_COMPACT_LATEST</option><option value="featured">COM_ACADEMY_COMPACT_FEATURED</option><option value="random">COM_ACADEMY_COMPACT_RANDOM</option><option value="related">COM_ACADEMY_COMPACT_RELATED</option>
      </field>
<field name="author_compact_heading_alignment" type="globaldefaultlist" globalcomponent="com_academy" addfieldprefix="Joomla\Component\Academy\Administrator\Field" label="COM_ACADEMY_COMPACT_HEADING_ALIGNMENT" useglobal="true">
