<?xml version="1.0" encoding="UTF-8"?>
<metadata>
  <layout title="COM_ACADEMY_AUTHOR_VIEW_DEFAULT_TITLE">
    <message>COM_ACADEMY_AUTHOR_VIEW_DEFAULT_DESC</message>
