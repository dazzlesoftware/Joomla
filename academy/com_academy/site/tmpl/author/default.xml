        <option value="0">JNO</option>
        <option value="1">JYES</option>
      </field>
<field name="author_compact_show_rating" type="globaldefaultlist" globalcomponent="com_academy" addfieldprefix="Joomla\Component\Academy\Administrator\Field" label="COM_ACADEMY_COMPACT_SHOW_RATING" useglobal="true"><option value="1">JSHOW</option><option value="0">JHIDE</option></field>
