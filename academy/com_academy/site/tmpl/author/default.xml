<field name="author_featured_slider_style" type="list" label="COM_ACADEMY_AUTHOR_FEATURED_SLIDER_STYLE_LABEL" useglobal="true"><option value="default">COM_ACADEMY_AUTHOR_FEATURED_SLIDER_STYLE_OPTION_DEFAULT</option><option value="card">COM_ACADEMY_AUTHOR_FEATURED_SLIDER_STYLE_OPTION_CARD</option><option value="hero">COM_ACADEMY_AUTHOR_FEATURED_SLIDER_STYLE_OPTION_HERO</option><option value="magazine">COM_ACADEMY_AUTHOR_FEATURED_SLIDER_STYLE_OPTION_MAGAZINE</option><option value="side-navigation">COM_ACADEMY_AUTHOR_FEATURED_SLIDER_STYLE_OPTION_SIDE_NAVIGATION</option><option value="slick">COM_ACADEMY_AUTHOR_FEATURED_SLIDER_STYLE_OPTION_SLICK</option><option value="thumbnail">COM_ACADEMY_AUTHOR_FEATURED_SLIDER_STYLE_OPTION_THUMBNAIL</option></field>
<field name="author_featured_slider_all_pages" type="list" label="COM_ACADEMY_AUTHOR_FEATURED_SLIDER_ALL_PAGES_LABEL" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="author_featured_slider_auto" type="list" label="COM_ACADEMY_AUTHOR_FEATURED_SLIDER_AUTO_LABEL" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
