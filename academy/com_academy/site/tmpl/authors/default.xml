<?xml version="1.0" encoding="UTF-8"?>
<metadata>
  <layout title="COM_ACADEMY_AUTHORS_VIEW_DEFAULT_TITLE">
    <message>COM_ACADEMY_AUTHORS_VIEW_DEFAULT_DESC</message>
  </layout>
  <fields name="params">
<fieldset name="request">
<field name="listing_authors" type="postauthors" label="Filter by Authors" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Academy\Administrator\Field" description="Leave empty for no restriction. Exclusions take priority over included items." />
<field name="listing_exclude_authors" type="postauthors" label="Exclude Authors" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Academy\Administrator\Field" description="Leave empty for no restriction. Exclusions take priority over included items." />
<field name="listing_categories" type="postcategory" label="Filter by Categories" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Academy\Administrator\Field" description="Leave empty for no restriction. Exclusions take priority over included items." />
<field name="listing_exclude_categories" type="postcategory" label="Exclude Categories" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Academy\Administrator\Field" description="Leave empty for no restriction. Exclusions take priority over included items." />
<field name="listing_tags" type="posttags" label="Filter by Tags" multiple="true" layout="joomla.form.field.list-fancy-select" filter="int_array" addfieldprefix="Joomla\Component\Academy\Administrator\Field" description="Leave empty for no restriction. Exclusions take priority over included items." />
<field name="listing_canonical" type="url" label="Custom Canonical Link" filter="url" relative="false" description="Optional absolute HTTP or HTTPS URL for this listing page." />
<field name="listing_subcategories" type="globaldefaultlist" globalcomponent="com_academy" addfieldprefix="Joomla\Component\Academy\Administrator\Field" label="Include Subcategories" useglobal="true" class="form-select-color-state" validate="options"><option value="0">JNO</option><option value="1">JYES</option></field>
</fieldset>
    <fieldset name="authors" label="COM_ACADEMY_AUTHORS_HEADING">
      <field name="authors_style" type="list" label="COM_ACADEMY_AUTHORS_STYLE" useglobal="true"><option value="link_list">COM_ACADEMY_AUTHORS_LINK_LIST</option><option value="image_grid">COM_ACADEMY_AUTHORS_IMAGE_GRID</option></field>
      <field name="authors_listing_layout" type="list" label="COM_ACADEMY_AUTHORS_LISTING" useglobal="true"><option value="rows">COM_ACADEMY_AUTHORS_ROWS</option><option value="columns">COM_ACADEMY_AUTHORS_COLUMNS</option></field>
      <field name="authors_columns" type="list" showon="authors_listing_layout:columns" label="COM_ACADEMY_AUTHORS_COLUMNS_COUNT" useglobal="true"><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
      <field name="authors_column_style" type="list" showon="authors_listing_layout:columns" label="COM_ACADEMY_AUTHORS_COLUMN_STYLE" useglobal="true"><option value="grid">COM_ACADEMY_AUTHORS_GRID</option><option value="masonry">COM_ACADEMY_AUTHORS_MASONRY</option></field>
      <field name="authors_per_page" type="number" label="COM_ACADEMY_AUTHORS_PER_PAGE" min="1" max="100" useglobal="true" />
      <field name="authors_pagination_summary" type="list" label="COM_ACADEMY_AUTHORS_PAGINATION_SUMMARY" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
    </fieldset>
    <fieldset name="pagevars" label="JOPTIONS">
      <field name="show_postnav" type="list" label="COM_ACADEMY_SHOW_POSTNAV_LABEL" description="COM_ACADEMY_SHOW_POSTNAV_DESC" useglobal="true" class="form-select-color-state" validate="options">
        <option value="0">JHIDE</option>
        <option value="1">JSHOW</option>
      </field>



    </fieldset>
  </fields>
</metadata>
