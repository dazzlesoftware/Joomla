<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade"><name>MOD_BLOG_TAGSPOPULAR</name><version>1.0.0</version><description>Family-specific Popular Post Tags module.</description><namespace path="src">Joomla\Module\BlogTagspopular</namespace><files><folder module="mod_blog_tagspopular">services</folder><folder>src</folder><folder>tmpl</folder></files><languages><language tag="en-GB">language/en-GB/mod_blog_tagspopular.ini</language><language tag="en-GB">language/en-GB/mod_blog_tagspopular.sys.ini</language></languages><config><fields name="params"><fieldset name="basic"><field name="catid" type="postcategory" addfieldprefix="Joomla\Component\blogTITLE\Administrator\Field" multiple="true" layout="joomla.form.field.list-fancy-select" label="Categories"/><field name="count" type="number" default="5" min="1" label="Number of items"/></fieldset><fieldset name="advanced"><field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL"/><field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"/><field name="cache" type="list" default="1" label="COM_MODULES_FIELD_CACHING_LABEL"><option value="1">JGLOBAL_USE_GLOBAL</option><option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option></field><field name="cache_time" type="number" default="900" label="COM_MODULES_FIELD_CACHE_TIME_LABEL"/></fieldset></fields></config></extension>