<?xml version="1.0" encoding="UTF-8"?>
<form>
  <config>
    <inlinehelp button="show" />
  </config>
  <fieldset addfieldprefix="Joomla\Component\Blog\Administrator\Field">
    <field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" class="readonly" default="0" readonly="true" />
    <field name="asset_id" type="hidden" filter="unset" />
    <field name="title" type="text" label="JGLOBAL_TITLE" required="true" maxlength="255" />
    <field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="JFIELD_ALIAS_DESC" hint="JFIELD_ALIAS_PLACEHOLDER" />
    <field name="note" type="text" label="COM_BLOG_FIELD_NOTE_LABEL" maxlength="255" />
    <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" maxlength="255" />
    <field name="excerpt" type="textarea" label="COM_BLOG_FIELD_EXCERPT_LABEL" description="COM_BLOG_FIELD_EXCERPT_DESC" rows="4" filter="string" />
    <field name="post_content" type="editor" label="COM_BLOG_FIELD_POST_CONTENT_LABEL" filter="\Joomla\CMS\Component\ComponentHelper::filterText" buttons="true" />
    <field name="block_data" type="hidden" filter="raw" />
    <field name="catid" type="postcategory" addfieldprefix="Joomla\Component\Blog\Administrator\Field" label="JCATEGORY" required="true" default="" />
    <field name="state" type="list" label="JSTATUS" class="form-select-color-state" default="1" validate="options">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="2">JARCHIVED</option>
      <option value="-2">JTRASHED</option>
      <option value="-3">COM_BLOG_POST_PENDING</option>
    </field>
    <field name="new_tag_titles" type="hidden" filter="string" /><field name="tags" type="posttags" addfieldprefix="Joomla\Component\Blog\Administrator\Field" label="JTAG" multiple="true" />
    <field name="created" type="calendar" label="COM_BLOG_FIELD_CREATED_LABEL" translateformat="true" showtime="true" filter="user_utc" />
    <field name="created_by" type="user" label="COM_BLOG_FIELD_CREATED_BY_LABEL" validate="UserId" />
    <field name="created_by_alias" type="text" label="COM_BLOG_FIELD_CREATED_BY_ALIAS_LABEL" />
    <field name="modified" type="calendar" label="JGLOBAL_FIELD_MODIFIED_LABEL" class="form-control" translateformat="true" showtime="true" readonly="true" filter="user_utc" />
    <field name="modified_by" type="user" label="JGLOBAL_FIELD_MODIFIED_BY_LABEL" class="readonly" readonly="true" filter="unset" validate="UserId" />
    <field name="checked_out" type="hidden" filter="unset" />
    <field name="checked_out_time" type="hidden" filter="unset" />
    <field name="publish_up" type="calendar" label="COM_BLOG_FIELD_PUBLISH_UP_LABEL" translateformat="true" showtime="true" filter="user_utc" />
    <field name="publish_down" type="calendar" label="COM_BLOG_FIELD_PUBLISH_DOWN_LABEL" translateformat="true" showtime="true" filter="user_utc" />
    <field name="featured_up" type="calendar" label="COM_BLOG_FIELD_FEATURED_UP_LABEL" translateformat="true" showtime="true" filter="user_utc" showon="featured:1" />
    <field name="featured_down" type="calendar" label="COM_BLOG_FIELD_FEATURED_DOWN_LABEL" translateformat="true" showtime="true" filter="user_utc" showon="featured:1" />
    <field name="version" type="text" label="COM_BLOG_FIELD_VERSION_LABEL" class="readonly" readonly="true" filter="unset" />
    <field name="ordering" type="text" label="JFIELD_ORDERING_LABEL" default="0" />
    <field name="metakey" type="textarea" label="JFIELD_META_KEYWORDS_LABEL" rows="3" cols="30" />
    <field name="metadesc" type="textarea" label="JFIELD_META_DESCRIPTION_LABEL" rows="3" cols="30" maxlength="300" charcounter="true" />
    <field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL" filter="UINT" validate="options" />
    <field name="hits" type="text" label="JGLOBAL_HITS" class="readonly" readonly="true" filter="unset" default="0" />
    <field name="language" type="contentlanguage" label="JFIELD_LANGUAGE_LABEL">
      <option value="*">JALL</option>
    </field>
    <field name="featured" type="radio" label="JFEATURED" layout="joomla.form.field.radio.switcher" default="0">
      <option value="0">JNO</option>
      <option value="1">JYES</option>
    </field>
    <field name="rules" type="rules" label="JFIELD_RULES_LABEL" translate_label="false" filter="rules" component="com_blog" section="post" validate="rules" />
    <field name="schema" type="hidden" />
  </fieldset>
  <fields name="options" label="COM_BLOG_ATTRIBS_FIELDSET_LABEL">
    <fieldset name="options" label="COM_BLOG_ATTRIBS_FIELDSET_LABEL">
      <fieldset name="basic" label="JFIELD_ALT_LAYOUT_LABEL">
        <field name="post_layout" type="componentlayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" useglobal="true" extension="com_blog" view="post" />
        <field name="show_wiki_details" type="list" class="form-select" useglobal="true" validate="options" label="COM_BLOG_WIKI_DETAILS_LABEL" description="COM_BLOG_WIKI_DETAILS_DESC"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="show_title" type="list" label="JGLOBAL_SHOW_TITLE_LABEL" useglobal="true" validate="options">
          <option value="1">JSHOW</option>
          <option value="0">JHIDE</option>
        </field>
        <field name="link_titles" type="list" label="JGLOBAL_LINKED_TITLES_LABEL" useglobal="true" validate="options">
          <option value="0">JNO</option>
          <option value="1">JYES</option>
        </field>
        <field name="show_tags" type="list" label="COM_BLOG_FIELD_SHOW_TAGS_LABEL" class="form-select-color" useglobal="true" validate="options">
          <option value="1">JSHOW</option>
          <option value="0">JHIDE</option>
        </field>
        <field name="show_intro" type="list" label="COM_BLOG_SHOW_EXCERPT_LABEL" class="form-select-color" useglobal="true" validate="options">
          <option value="1">JSHOW</option>
          <option value="0">JHIDE</option>
        </field>
        <field name="info_block_show_title" type="list" label="COM_BLOG_FIELD_INFOBLOCK_TITLE_LABEL" useglobal="true" validate="options">
          <option value="0">JHIDE</option>
          <option value="1">JSHOW</option>
        </field>
      </fieldset>
      <fieldset name="category" label="JCATEGORY">
        <field name="show_category" type="list" label="JGLOBAL_SHOW_CATEGORY_LABEL" useglobal="true" validate="options">
          <option value="0">JHIDE</option>
          <option value="1">JSHOW</option>
        </field>
        <field name="link_category" type="list" label="JGLOBAL_LINK_CATEGORY_LABEL" useglobal="true" validate="options">
          <option value="0">JNO</option>
          <option value="1">JYES</option>
        </field>
        <field name="show_parent_category" type="list" label="JGLOBAL_SHOW_PARENT_CATEGORY_LABEL" useglobal="true" validate="options">
          <option value="0">JHIDE</option>
          <option value="1">JSHOW</option>
        </field>
        <field name="link_parent_category" type="list" label="JGLOBAL_LINK_PARENT_CATEGORY_LABEL" useglobal="true" validate="options">
          <option value="0">JNO</option>
          <option value="1">JYES</option>
        </field>
      </fieldset>
      <fieldset name="frontendassociations" label="JGLOBAL_FIELDSET_ASSOCIATIONS">
        <field name="show_associations" type="assoc" label="JGLOBAL_SHOW_ASSOCIATIONS_LABEL" useglobal="true">
          <option value="1">JSHOW</option>
          <option value="0">JHIDE</option>
        </field>
        <field name="flags" type="list" label="JGLOBAL_SHOW_FLAG_LABEL" useglobal="true" showon="show_associations:1" validate="options">
          <option value="0">JNO</option>
          <option value="1">JYES</option>
        </field>
      </fieldset>
      <fieldset name="author" label="JGLOBAL_SHOW_AUTHOR_LABEL">
        <field name="show_author" type="list" label="JGLOBAL_SHOW_AUTHOR_LABEL" useglobal="true" validate="options">
          <option value="0">JHIDE</option>
          <option value="1">JSHOW</option>
        </field>
        <field name="link_author" type="list" label="JGLOBAL_LINK_AUTHOR_LABEL" useglobal="true" validate="options">
          <option value="0">JNO</option>
          <option value="1">JYES</option>
        </field>
      </fieldset>
      <fieldset name="date" label="JDATE">
        <field name="show_date" type="list" useglobal="true" class="form-select" validate="options" label="Show Date" translate_label="false"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
      <field name="date_type" type="list" class="form-select" useglobal="true" label="Date Type" translate_label="false" validate="options"><option value="created">JGLOBAL_SHOW_CREATE_DATE_LABEL</option><option value="modified">JGLOBAL_SHOW_MODIFY_DATE_LABEL</option><option value="published">JGLOBAL_SHOW_PUBLISH_DATE_LABEL</option></field>


      </fieldset>
      <fieldset name="other" label="COM_BLOG_OTHER_OPTIONS">
        <field name="show_item_navigation" type="list" label="COM_BLOG_SHOW_PAGINATION_LABEL" useglobal="true" validate="options">
          <option value="0">JHIDE</option>
          <option value="1">JSHOW</option>
        </field>
        <field name="show_vote" type="votelist" label="JGLOBAL_SHOW_VOTE_LABEL" useglobal="true" validate="options">
          <option value="0">JHIDE</option>
          <option value="1">JSHOW</option>
        </field>
        <field name="show_hits" type="list" label="JGLOBAL_SHOW_HITS_LABEL" useglobal="true" validate="options">
          <option value="0">JHIDE</option>
          <option value="1">JSHOW</option>
        </field>
        <field name="show_noauth" type="list" label="JGLOBAL_SHOW_UNAUTH_LINKS_LABEL" description="JGLOBAL_SHOW_UNAUTH_LINKS_DESC" useglobal="true" validate="options">
          <option value="0">JNO</option>
          <option value="1">JYES</option>
        </field>
        <field name="show_postnav" type="list" label="COM_BLOG_SHOW_POSTNAV_LABEL" description="COM_BLOG_SHOW_POSTNAV_DESC" useglobal="true" validate="options">
          <option value="0">JHIDE</option>
          <option value="1">JSHOW</option>
        </field>
        <field name="urls_position" type="list" label="COM_BLOG_FIELD_URLSPOSITION_LABEL" useglobal="true" filter="integer" validate="options">
          <option value="0">COM_BLOG_FIELD_OPTION_ABOVE</option>
          <option value="1">COM_BLOG_FIELD_OPTION_BELOW</option>
          <option value="-1">JHIDE</option>
        </field>
        <field name="alternative_readmore" type="text" label="JFIELD_READMORE_LABEL" description="JFIELD_READMORE_DESC" />
        <field name="post_page_title" type="text" label="COM_BLOG_FIELD_BROWSER_PAGE_TITLE_LABEL" />
      </fieldset>
    </fieldset>
    <fieldset name="editorConfig" label="COM_BLOG_EDITORCONFIG_FIELDSET_LABEL">
      <field name="show_publishing_options" type="list" label="COM_BLOG_SHOW_PUBLISHING_OPTIONS_LABEL" default="" useglobal="true" validate="options">
        <option value="0">JHIDE</option>
        <option value="1">JSHOW</option>
      </field>
      <field name="show_post_options" type="list" label="COM_BLOG_SHOW_POST_OPTIONS_LABEL" default="" useglobal="true" validate="options">
        <option value="0">JHIDE</option>
        <option value="1">JSHOW</option>
      </field>
      <field name="show_urls_images_backend" type="list" label="COM_BLOG_SHOW_IMAGES_URLS_BACK_LABEL" useglobal="true" default="" validate="options">
        <option value="0">JNO</option>
        <option value="1">JYES</option>
      </field>
      <field name="show_urls_images_frontend" type="list" label="COM_BLOG_SHOW_IMAGES_URLS_FRONT_LABEL" useglobal="true" default="" validate="options">
        <option value="0">JNO</option>
        <option value="1">JYES</option>
      </field>
    </fieldset>
    <fieldset name="basic-limited" label="COM_BLOG_ATTRIBS_FIELDSET_LABEL">
      <field name="show_title" type="hidden" label="JGLOBAL_SHOW_TITLE_LABEL" />
      <field name="link_titles" type="hidden" label="JGLOBAL_LINKED_TITLES_LABEL" />
      <field name="show_intro" type="hidden" label="COM_BLOG_SHOW_EXCERPT_LABEL" />
      <field name="show_category" type="hidden" label="JGLOBAL_SHOW_CATEGORY_LABEL" />
      <field name="link_category" type="hidden" label="JGLOBAL_LINK_CATEGORY_LABEL" />
      <field name="show_parent_category" type="hidden" label="JGLOBAL_SHOW_PARENT_CATEGORY_LABEL" />
      <field name="link_parent_category" type="hidden" label="JGLOBAL_LINK_PARENT_CATEGORY_LABEL" />
      <field name="show_author" type="hidden" label="JGLOBAL_SHOW_AUTHOR_LABEL" />
      <field name="link_author" type="hidden" label="JGLOBAL_LINK_AUTHOR_LABEL" />
      <field name="show_date" type="hidden" /><field name="date_type" type="hidden" />
      <field name="author" type="text" label="JAUTHOR" />
      <field name="rights" type="textarea" label="JFIELD_META_RIGHTS_LABEL" filter="string" cols="30" rows="2" />
    </fieldset>
  </fields>
  <!-- These fields are used to get labels for the Content History Preview and Compare Views -->
  <fields>
    <field name="summary" label="COM_BLOG_FIELD_SUMMARY" filter="\Joomla\CMS\Component\ComponentHelper::filterText" />
    <field name="body" label="COM_BLOG_FIELD_BODY" filter="\Joomla\CMS\Component\ComponentHelper::filterText" />
  </fields>
  <fields name="media" label="COM_BLOG_FIELD_IMAGE_OPTIONS">
    <fieldset name="image-featured" label="COM_BLOG_FIELD_FEATURED_LABEL">
      <field name="featured_image" type="media" label="COM_BLOG_FIELD_FEATURED_LABEL" schemes="http,https,ftp,ftps,data,file" validate="url" relative="true" />
      <field name="featured_image_alt" type="text" label="COM_BLOG_FIELD_IMAGE_ALT_LABEL" />
      <field name="featured_image_alt_empty" type="checkbox" label="COM_BLOG_FIELD_IMAGE_ALT_EMPTY_LABEL" description="COM_BLOG_FIELD_IMAGE_ALT_EMPTY_DESC" />
      <field name="featured_image_class" type="text" label="COM_BLOG_FIELD_IMAGE_CLASS_LABEL" description="COM_BLOG_FIELD_IMAGE_CLASS_DESC" useglobal="true" validate="CssIdentifier" />
      <field name="featured_image_caption" type="text" label="COM_BLOG_FIELD_IMAGE_CAPTION_LABEL" />
    </fieldset>
  </fields>
</form>
