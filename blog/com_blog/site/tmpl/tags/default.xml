<?xml version="1.0" encoding="utf-8"?>
<metadata><layout title="(Tags) Browse Tags"><message>Browse this component's independent tags or posts for a selected tag.</message></layout><fields name="request"><fieldset name="request"><field name="tag_id" type="posttags" addfieldprefix="Joomla\Component\Blog\Administrator\Field" label="Tag" description="Leave empty to show all tags."><option value="0">All tags</option></field></fieldset></fields><fields name="params">
<fieldset name="tags_directory" label="COM_BLOG_TAGS_LAYOUT">
<field name="tags_style" type="list" label="COM_BLOG_TAGS_STYLE" useglobal="true"><option value="link_grid">COM_BLOG_TAGS_LINK</option><option value="image_grid">COM_BLOG_TAGS_IMAGE</option></field>
<field name="tags_listing_layout" type="list" label="COM_BLOG_TAGS_LISTING" useglobal="true"><option value="rows">COM_BLOG_TAGS_ROWS</option><option value="columns">COM_BLOG_TAGS_COLUMNS_LAYOUT</option></field>
<field name="tags_columns" type="list" label="COM_BLOG_TAGS_COLUMNS" useglobal="true" showon="tags_listing_layout:columns,"><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
<field name="tags_column_style" type="list" label="COM_BLOG_TAGS_COLUMN_STYLE" useglobal="true" showon="tags_listing_layout:columns,"><option value="grid">COM_BLOG_TAGS_GRID</option><option value="masonry">COM_BLOG_TAGS_MASONRY</option></field>
<field name="tags_per_page" type="number" filter="integer" min="1" max="100" label="COM_BLOG_TAGS_PER_PAGE" useglobal="true" />
<field name="tags_show_count" type="list" label="COM_BLOG_TAGS_SHOW_COUNT" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="tags_show_rss" type="list" label="COM_BLOG_TAGS_SHOW_RSS" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="tags_show_description" type="list" label="COM_BLOG_TAGS_SHOW_DESCRIPTION" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="tags_description_length" type="number" filter="integer" min="1" max="2000" label="COM_BLOG_TAGS_DESCRIPTION_LENGTH" useglobal="true" />
<field name="tags_show_empty" type="list" label="COM_BLOG_TAGS_SHOW_EMPTY" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="tags_show_search" type="list" label="COM_BLOG_TAGS_SHOW_SEARCH" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="tags_show_sort" type="list" label="COM_BLOG_TAGS_SHOW_SORT" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="tags_order" type="list" label="COM_BLOG_TAGS_ORDER" useglobal="true"><option value="title">COM_BLOG_TAGS_ORDER_TITLE</option><option value="title_desc">COM_BLOG_TAGS_ORDER_TITLE_DESC</option><option value="count">COM_BLOG_TAGS_ORDER_COUNT</option><option value="newest">COM_BLOG_TAGS_ORDER_NEWEST</option></field>
<field name="tags_pagination" type="list" label="COM_BLOG_TAGS_PAGINATION" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="tags_pagination_summary" type="list" label="COM_BLOG_TAGS_PAGINATION_SUMMARY" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="tags_exclusions_override" type="list" default="0" label="COM_BLOG_TAGS_EXCLUSIONS_MODE"><option value="0">JGLOBAL_USE_GLOBAL</option><option value="1">COM_BLOG_TAGS_EXCLUSIONS_CUSTOM</option></field>
<field name="tags_exclude_tags" type="posttags" multiple="true" filter="int_array" layout="joomla.form.field.list-fancy-select" addfieldprefix="Joomla\Component\Blog\Administrator\Field" label="COM_BLOG_TAGS_EXCLUDE_TAGS" description="COM_BLOG_TAGS_EXCLUDE_TAGS_DESC" showon="tags_exclusions_override:1" />
<field name="tags_exclude_categories" type="postcategory" multiple="true" filter="int_array" layout="joomla.form.field.list-fancy-select" addfieldprefix="Joomla\Component\Blog\Administrator\Field" label="COM_BLOG_TAGS_EXCLUDE_CATEGORIES" description="COM_BLOG_TAGS_EXCLUDE_CATEGORIES_DESC" showon="tags_exclusions_override:1" />
<field name="tags_exclude_posts" type="postchoices" multiple="true" filter="int_array" layout="joomla.form.field.list-fancy-select" addfieldprefix="Joomla\Component\Blog\Administrator\Field" label="COM_BLOG_TAGS_EXCLUDE_POSTS" description="COM_BLOG_TAGS_EXCLUDE_POSTS_DESC" showon="tags_exclusions_override:1" />
</fieldset>

<fieldset name="automated_truncation" label="Automated Truncation" description="Shorten list content automatically. Manual excerpts and Read More splits take precedence. Featured slider content uses its own settings.">
<field name="truncation_enabled" type="list" label="Enable Automated Truncation" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="truncation_readmore" type="list" label="Display Readmore Button When Necessary" useglobal="true"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="truncation_image_position" type="list" label="Position of Images After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_video_position" type="list" label="Position of Videos After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_audio_position" type="list" label="Position of Audio Embed After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_gallery_position" type="list" label="Position of Gallery After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_accordion_position" type="list" label="Position of Accordion After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_alert_position" type="list" label="Position of Alert After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_button_position" type="list" label="Position of Button After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_columns_position" type="list" label="Position of Columns After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_comparison_position" type="list" label="Position of Comparison After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_embed_position" type="list" label="Position of Embed After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_poll_position" type="list" label="Position of Poll After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_quote_position" type="list" label="Position of Quote After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_rule_position" type="list" label="Position of Rule After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_section_position" type="list" label="Position of Section After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_tabs_position" type="list" label="Position of Tabs After Truncation" useglobal="true"><option value="top">Top</option><option value="bottom">Bottom</option><option value="hide">Do Not Display Items</option></field>
<field name="truncation_type" type="list" label="Truncation Type (Joomla Editor)" useglobal="true"><option value="characters">By characters</option><option value="words">By words</option><option value="paragraphs">By paragraph &lt;p&gt;</option><option value="breaks">By break tags &lt;br&gt;</option></field>
<field name="truncation_content_override" type="radio" default="0" label="Maximum Content (Characters or Words)" layout="joomla.form.field.radio"><option value="0">Inherit from default settings</option><option value="1">Use this option</option></field>
<field name="list_excerpt_length" type="number" filter="integer" min="0" label="Maximum Content (Characters or Words)" description="0 displays all content without automatic truncation." hint="400" showon="truncation_content_override:1" />
<field name="truncation_paragraph_override" type="radio" default="0" label="Maximum Paragraph (Paragraph or Break Tags)" layout="joomla.form.field.radio"><option value="0">Inherit from default settings</option><option value="1">Use this option</option></field>
<field name="truncation_paragraphs" type="number" filter="integer" min="0" label="Maximum Paragraph (Paragraph or Break Tags)" description="0 displays all content without automatic truncation." hint="1" showon="truncation_paragraph_override:1" />
</fieldset>
<fieldset name="pagevars" label="COM_MENUS_PAGE_DISPLAY_OPTIONS_FIELDSET_LABEL"><field name="show_postnav" type="list" label="COM_BLOG_SHOW_POSTNAV_LABEL" description="COM_BLOG_SHOW_POSTNAV_DESC" useglobal="true" class="form-select-color-state" validate="options"><option value="0">JHIDE</option><option value="1">JSHOW</option></field>
<field name="postnav_home" type="list" label="COM_BLOG_POSTNAV_HOME_LABEL" description="COM_BLOG_POSTNAV_HOME_DESC" useglobal="true"><option value="featured">COM_BLOG_POSTNAV_HOME_FEATURED</option><option value="categories">COM_BLOG_POSTNAV_HOME_CATEGORIES</option><option value="authors">COM_BLOG_POSTNAV_HOME_AUTHORS</option><option value="archive">COM_BLOG_POSTNAV_HOME_ARCHIVE</option><option value="menu">COM_BLOG_POSTNAV_HOME_MENU</option></field>
<field name="postnav_home_menu" type="menuitem" label="COM_BLOG_POSTNAV_HOME_MENU_LABEL" description="COM_BLOG_POSTNAV_HOME_MENU_DESC" clientid="0" published="1" filter="integer" showon="postnav_home:menu," useglobal="true"><option value="">JGLOBAL_USE_GLOBAL</option></field>
</fieldset></fields></metadata>
