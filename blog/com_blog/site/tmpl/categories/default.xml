<?xml version="1.0" encoding="UTF-8"?>
<metadata>
	<layout title="COM_BLOG_CATEGORIES_VIEW_DEFAULT_TITLE" option="COM_BLOG_CATEGORIES_VIEW_DEFAULT_OPTION">
		<help
			key = "Menu_Item:_List_All_Categories"
		/>
		<message>
			<![CDATA[COM_BLOG_CATEGORIES_VIEW_DEFAULT_DESC]]>
		</message>
	</layout>

	<!-- Add fields to the request variables for the layout. -->
	<fields name="request">
		<fieldset name="request"
		>
			<field
				name="id"
				type="postcategory" addfieldprefix="Joomla\Component\Blog\Administrator\Field"
				label="JGLOBAL_FIELD_CATEGORIES_CHOOSE_CATEGORY_LABEL"
				extension="com_blog"
				show_root="true"
				required="true"
			/>
		</fieldset>
	</fields>

	<!-- Add fields to the parameters object for the layout. -->
	<fields name="params">
        <fieldset name="request" label="Layout">
      <field name="categories_style" type="globaldefaultlist" globalcomponent="com_blog" addfieldprefix="Joomla\Component\Blog\Administrator\Field" label="Categories Layout" useglobal="true"><option value="list">Default Link List</option><option value="image_grid">Image Grid</option></field>
      <field name="categories_listing_layout" type="globaldefaultlist" globalcomponent="com_blog" addfieldprefix="Joomla\Component\Blog\Administrator\Field" label="Category Listing Style" useglobal="true"><option value="rows">Rows</option><option value="columns">Columns</option></field>
      <field name="categories_column_style" type="globaldefaultlist" globalcomponent="com_blog" addfieldprefix="Joomla\Component\Blog\Administrator\Field" label="Column Style" useglobal="true"><option value="grid">Grid Layout</option><option value="masonry">Masonry Layout</option></field>
      <field name="categories_columns" type="globaldefaultlist" globalcomponent="com_blog" addfieldprefix="Joomla\Component\Blog\Administrator\Field" label="Columns Per Row" useglobal="true"><option value="2">2 Columns</option><option value="3">3 Columns</option><option value="4">4 Columns</option><option value="5">5 Columns</option><option value="6">6 Columns</option></field>

        </fieldset>
		<fieldset name="basic" label="JGLOBAL_CATEGORIES_OPTIONS">

			<field
				name="show_base_description"
				type="globaldefaultlist" globalcomponent="com_blog" addfieldprefix="Joomla\Component\Blog\Administrator\Field"
				label="JGLOBAL_FIELD_SHOW_BASE_DESCRIPTION_LABEL"
				useglobal="true"
				class="form-select-color-state"
				validate="options"
				>
				<option value="0">JHIDE</option>
				<option value="1">JSHOW</option>
			</field>

			<field
				name="categories_description"
				type="textarea"
				label="JGLOBAL_FIELD_CATEGORIES_DESC_LABEL"
				cols="25"
				rows="5"
			/>

			<field
				name="maxLevelcat"
				type="globaldefaultlist" globalcomponent="com_blog" addfieldprefix="Joomla\Component\Blog\Administrator\Field"
				label="JGLOBAL_MAXIMUM_CATEGORY_LEVELS_LABEL"
				useglobal="true"
				validate="options"
				>
				<option value="-1">JALL</option>
				<option value="1">J1</option>
				<option value="2">J2</option>
				<option value="3">J3</option>
				<option value="4">J4</option>
				<option value="5">J5</option>
			</field>

			<field
				name="show_empty_categories_cat"
				type="globaldefaultlist" globalcomponent="com_blog" addfieldprefix="Joomla\Component\Blog\Administrator\Field"
				label="JGLOBAL_SHOW_EMPTY_CATEGORIES_LABEL"
				useglobal="true"
				class="form-select-color-state"
				validate="options"
				>
				<option value="0">JHIDE</option>
				<option value="1">JSHOW</option>
			</field>

			<field
				name="show_subcat_desc_cat"
				type="globaldefaultlist" globalcomponent="com_blog" addfieldprefix="Joomla\Component\Blog\Administrator\Field"
				label="JGLOBAL_SHOW_SUBCATEGORIES_DESCRIPTION_LABEL"
				useglobal="true"
				class="form-select-color-state"
				validate="options"
				>
				<option value="0">JHIDE</option>
				<option value="1">JSHOW</option>
			</field>

			<field
				name="show_cat_num_posts_cat"
				type="globaldefaultlist" globalcomponent="com_blog" addfieldprefix="Joomla\Component\Blog\Administrator\Field"
				label="COM_BLOG_NUMBER_CATEGORY_ITEMS_LABEL"
				useglobal="true"
				class="form-select-color-state"
				validate="options"
				>
				<option value="0">JHIDE</option>
				<option value="1">JSHOW</option>
			</field>
	</fieldset>

		<fieldset name="post" label="JOPTIONS">
<field
				name="show_postnav"
				type="globaldefaultlist" globalcomponent="com_blog" addfieldprefix="Joomla\Component\Blog\Administrator\Field"
				label="COM_BLOG_SHOW_POSTNAV_LABEL"
				description="COM_BLOG_SHOW_POSTNAV_DESC"
				useglobal="true"
				class="form-select-color-state"
				validate="options"
				>
				<option value="0">JHIDE</option>
				<option value="1">JSHOW</option>
			</field>
</fieldset>

	</fields>
</metadata>
