<?xml version="1.0" encoding="UTF-8"?>
<form>
  <fieldset>
    <field name="id" type="hidden" label="COM_BLOG_ID_LABEL" size="10" default="0" readonly="true" />
    <field name="contenthistory" type="contenthistory" label="JTOOLBAR_VERSIONS" data-typeAlias="com_blog.post" />
    <field name="asset_id" type="hidden" filter="unset" />
    <field name="title" type="text" label="JGLOBAL_TITLE" size="30" required="true" />
    <field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="JFIELD_ALIAS_DESC" hint="JFIELD_ALIAS_PLACEHOLDER" size="45" />
    <field name="excerpt" type="textarea" label="Excerpt" rows="4" filter="string" />
<field name="post_content" type="editor" label="COM_BLOG_FIELD_POST_CONTENT_LABEL" hiddenLabel="true" buttons="true" filter="\Joomla\CMS\Component\ComponentHelper::filterText" asset_id="com_blog" />
    <field name="state" type="list" label="JSTATUS" class="form-select-color-state" size="1" default="1" validate="options">
      <option value="1">JPUBLISHED</option>
      <option value="0">JUNPUBLISHED</option>
      <option value="2">JARCHIVED</option>
      <option value="-2">JTRASHED</option>
    </field>
    <field name="featured" type="list" label="JGLOBAL_FIELD_FEATURED_LABEL" default="0" validate="options">
      <option value="0">JNO</option>
      <option value="1">JYES</option>
    </field>
    <field name="featured_up" type="calendar" label="COM_BLOG_FIELD_FEATURED_UP_LABEL" translateformat="true" showtime="true" size="22" filter="user_utc" showon="featured:1" />
    <field name="featured_down" type="calendar" label="COM_BLOG_FIELD_FEATURED_DOWN_LABEL" translateformat="true" showtime="true" size="22" filter="user_utc" showon="featured:1" />
    <field name="catid" type="postcategory" addfieldprefix="Joomla\Component\Blog\Administrator\Field" label="JCATEGORY" extension="com_blog" required="true" />
    <field name="created" type="calendar" translateformat="true" filter="unset" />
    <field name="created_by" type="text" filter="unset" />
    <field name="created_by_alias" type="text" label="JGLOBAL_FIELD_CREATED_BY_ALIAS_LABEL" size="20" />
    <field name="note" type="text" label="COM_BLOG_FIELD_NOTE_LABEL" size="40" maxlength="255" />
    <field name="version_note" type="text" label="JGLOBAL_FIELD_VERSION_NOTE_LABEL" maxlength="255" size="45" />
    <field name="publish_up" type="calendar" label="JGLOBAL_FIELD_PUBLISH_UP_LABEL" translateformat="true" showtime="true" size="22" filter="user_utc" />
    <field name="publish_down" type="calendar" label="JGLOBAL_FIELD_PUBLISH_DOWN_LABEL" translateformat="true" showtime="true" size="22" filter="user_utc" />
    <field name="language" type="contentlanguage" label="JFIELD_LANGUAGE_LABEL">
      <option value="*">JALL</option>
    </field>
    <field name="new_tag_titles" type="hidden" filter="string" /><field name="tags" type="posttags" addfieldprefix="Joomla\Component\Blog\Administrator\Field" label="JTAG" multiple="true" size="45" />
    <field name="metakey" type="textarea" label="JFIELD_META_KEYWORDS_LABEL" rows="5" cols="50" />
    <field name="metadesc" type="textarea" label="JFIELD_META_DESCRIPTION_LABEL" rows="3" cols="30" maxlength="300" charcounter="true" />
    <field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL" filter="UINT" validate="options" />
    <field name="captcha" type="captcha" label="COM_BLOG_CAPTCHA_LABEL" validate="captcha" namespace="post" />
  </fieldset>
  <fields name="media">
    <fieldset name="image-featured">
      <field name="featured_image" type="media" schemes="http,https,ftp,ftps,data,file" validate="url" relative="true" label="COM_BLOG_FIELD_FEATURED_LABEL" />
      <field name="featured_image_alt" type="text" label="COM_BLOG_FIELD_IMAGE_ALT_LABEL" size="20" />
      <field name="featured_image_alt_empty" type="checkbox" label="COM_BLOG_FIELD_IMAGE_ALT_EMPTY_LABEL" description="COM_BLOG_FIELD_IMAGE_ALT_EMPTY_DESC" />
      <field name="featured_image_caption" type="text" label="COM_BLOG_FIELD_IMAGE_CAPTION_LABEL" size="20" />
      <field name="featured_image_class" type="text" label="COM_BLOG_FIELD_IMAGE_CLASS_LABEL" size="20" useglobal="true" validate="CssIdentifier" />
    </fieldset>
  </fields>

<fields name="metadata"><fieldset name="jmetadata" label="SEO and Social Sharing">
<field name="seo_title" type="text" label="SEO title" maxlength="255" description="Leave blank to use the post title and existing page-title settings." />
<field name="robots" type="list" label="Robots" validate="options" description="Per-page indexing directives. This does not edit the site robots.txt file."><option value="">JGLOBAL_USE_GLOBAL</option><option value="index, follow">index, follow</option><option value="noindex, follow">noindex, follow</option><option value="index, nofollow">index, nofollow</option><option value="noindex, nofollow">noindex, nofollow</option></field>
<field name="canonical" type="url" label="Canonical URL" filter="url" description="Optional absolute preferred URL for this post." />
<field name="og_type" type="list" label="Open Graph Type" default="" validate="options"><option value="">Article (default)</option><option value="website">Website</option><option value="article">Article</option><option value="video.movie">Video: Movie</option><option value="video.tv_show">Video: TV Show</option><option value="music.album">Music: Album</option><option value="book">Book</option><option value="profile">Profile</option></field>
<field name="og_title" type="text" label="Open Graph Title" maxlength="255" />
<field name="og_description" type="textarea" label="Open Graph Description" maxlength="500" rows="3" />
<field name="og_image" type="media" label="Open Graph Image" directory="" description="Leave empty to use the featured image." />
<field name="image_alt" type="text" label="Open Graph Image Alt Text" maxlength="255" />
<field name="twitter_card" type="list" label="Social card format" default="summary_large_image" validate="options"><option value="summary_large_image">Large image</option><option value="summary">Summary</option></field>
<field name="author" type="text" label="JAUTHOR" />
<field name="rights" type="text" label="JFIELD_META_RIGHTS_LABEL" />
</fieldset></fields>
</form>